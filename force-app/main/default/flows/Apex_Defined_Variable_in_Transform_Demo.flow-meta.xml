<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_To_Outreach_List</name>
        <label>Add To Outreach List</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Outreach_Ready_List</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Outreach_Ready_Row</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Outreach_Ready_Count</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Contacts</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_All_Contacts</name>
        <label>Assign All Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>contactsToProcess</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Contacts</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Transform_contacts</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Incomplete_Contacts</name>
        <label>Assign Incomplete Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>contactsToProcess</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Filter_Incomplete_Contacts</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Any_Incomplete_Contacts</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Build_Enrichment_Task</name>
        <label>Build Enrichment Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Needs_Enrichment_List</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Needs_Enrichment_Row</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Needs_Enrichment_Count</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newTask.Subject</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Complete missing contact details</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newTask.WhoId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Contacts.contactId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newTask.Description</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Needs_Enrichment_Row</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newTask.ActivityDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Follow_Up_Due_Date</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newTask.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newTask.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>tasksToCreate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>newTask</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Contacts</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Filter_Incomplete_Contacts</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter Incomplete Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Filter_Incomplete_Contacts</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Contacts</collectionReference>
        <conditionLogic>or</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Incomplete_Contacts.Email</leftValueReference>
            <operator>IsNull</operator>
            <rightValue>
                <booleanValue>true</booleanValue>
            </rightValue>
        </conditions>
        <conditions>
            <leftValueReference>currentItem_Filter_Incomplete_Contacts.MobilePhone</leftValueReference>
            <operator>IsNull</operator>
            <rightValue>
                <booleanValue>true</booleanValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Assign_Incomplete_Contacts</targetReference>
        </connector>
    </collectionProcessors>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Any_Incomplete_Contacts</name>
        <label>Any Incomplete Contacts?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Results</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Everyone Is Complete</defaultConnectorLabel>
        <rules>
            <name>Incomplete_Contacts_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>contactsToProcess</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Transform_contacts</targetReference>
            </connector>
            <label>Incomplete Contacts Exist</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Contact_Completeness</name>
        <label>Check Contact Completeness</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Build_Enrichment_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Needs Enrichment</defaultConnectorLabel>
        <rules>
            <name>Outreach_Ready</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Contacts.contactEmail</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Contacts.contactPhone</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_To_Outreach_List</targetReference>
            </connector>
            <label>Outreach Ready</label>
        </rules>
    </decisions>
    <decisions>
        <name>Contacts_Found</name>
        <label>Contacts Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Results</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Contacts Found</defaultConnectorLabel>
        <rules>
            <name>Has_Contacts</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contacts</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Only_Missing_Details_Selected</targetReference>
            </connector>
            <label>Has Contacts</label>
        </rules>
    </decisions>
    <decisions>
        <name>Create_Tasks_Requested</name>
        <label>Create Tasks Requested?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Results</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Skip Task Creation</defaultConnectorLabel>
        <rules>
            <name>Create_Tasks</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Create_Follow_Up_Tasks</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>tasksToCreate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Task_Records</targetReference>
            </connector>
            <label>Create Tasks</label>
        </rules>
    </decisions>
    <decisions>
        <name>Only_Missing_Details_Selected</name>
        <label>Only Missing Details Selected?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_All_Contacts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Process All Matches</defaultConnectorLabel>
        <rules>
            <name>Only_Missing_Details</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Only_Missing_Info</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Filter_Incomplete_Contacts</targetReference>
            </connector>
            <label>Only Missing Details</label>
        </rules>
    </decisions>
    <description>Screen flow that builds an outreach worklist. Contacts matching the entered name are queried, optionally filtered down to records missing an email or mobile phone, then converted into a ContactWrapperDemo (Apex-defined) collection with a Transform element. The wrapper collection is looped to split contacts into outreach-ready vs needs-enrichment groups and, on request, to build follow-up Tasks that are inserted in a single bulk DML.</description>
    <environments>Default</environments>
    <formulas>
        <name>Follow_Up_Due_Date</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 3</expression>
    </formulas>
    <formulas>
        <name>Needs_Enrichment_Row</name>
        <dataType>String</dataType>
        <expression>&quot;- &quot; &amp; BLANKVALUE({!Loop_Contacts.contactFirstName}, &quot;&quot;) &amp; &quot; &quot; &amp; {!Loop_Contacts.contactLastName} &amp; &quot; (missing: &quot; &amp; IF(ISBLANK({!Loop_Contacts.contactEmail}), &quot;Email &quot;, &quot;&quot;) &amp; IF(ISBLANK({!Loop_Contacts.contactPhone}), &quot;Mobile Phone&quot;, &quot;&quot;) &amp; &quot;)&lt;br/&gt;&quot;</expression>
    </formulas>
    <formulas>
        <name>Outreach_Ready_Row</name>
        <dataType>String</dataType>
        <expression>&quot;- &quot; &amp; BLANKVALUE({!Loop_Contacts.contactFirstName}, &quot;&quot;) &amp; &quot; &quot; &amp; {!Loop_Contacts.contactLastName} &amp; &quot;: &quot; &amp; {!Loop_Contacts.contactEmail} &amp; &quot; / &quot; &amp; {!Loop_Contacts.contactPhone} &amp; &quot;&lt;br/&gt;&quot;</expression>
    </formulas>
    <formulas>
        <name>Total_Contacts_Processed</name>
        <dataType>Number</dataType>
        <expression>{!Outreach_Ready_Count} + {!Needs_Enrichment_Count}</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Apex Defined Variable in Transform Demo {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Apex Defined Variable in Transform Demo</label>
    <loops>
        <name>Loop_Contacts</name>
        <label>Loop Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Transform_contacts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_Contact_Completeness</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Tasks_Requested</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Task_Records</name>
        <label>Create Task Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Results</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <inputReference>tasksToCreate</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Contacts</name>
        <label>Get Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Contacts_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>Contains</operator>
            <value>
                <elementReference>Enter_Contact_Name</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contact</object>
        <sortField>LastName</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Contact_Screen</name>
        <label>Contact Screen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Get_Contacts</targetReference>
        </connector>
        <fields>
            <name>Search_Header</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Build an outreach worklist&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Search for contacts by name. Matching records are converted into an Apex-defined collection and split into contacts that are ready for outreach and contacts whose details need enrichment.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Enter_Contact_Name</name>
            <dataType>String</dataType>
            <fieldText>Enter Contact Name</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Only_Missing_Info</name>
            <dataType>Boolean</dataType>
            <defaultValue>
                <booleanValue>false</booleanValue>
            </defaultValue>
            <fieldText>Only include contacts missing an email or mobile phone</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Create_Follow_Up_Tasks</name>
            <dataType>Boolean</dataType>
            <defaultValue>
                <booleanValue>false</booleanValue>
            </defaultValue>
            <fieldText>Create a follow-up task for every contact that needs enrichment</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Error_Screen</name>
        <label>Error Screen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Error_Message</name>
            <fieldText>&lt;p&gt;The outreach worklist could not be built.&lt;/p&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>No_Results</name>
        <label>No Results</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>No_Results_Message</name>
            <fieldText>&lt;p&gt;No contacts matched &quot;{!Enter_Contact_Name}&quot; for the options you selected.&lt;/p&gt;&lt;p&gt;Go back to widen the search, or clear the &quot;missing details only&quot; option.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Results</name>
        <label>Results</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>contactsPrint</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Search:&lt;/b&gt; {!Enter_Contact_Name}&lt;/p&gt;&lt;p&gt;&lt;b&gt;Contacts processed:&lt;/b&gt; {!Total_Contacts_Processed}&lt;/p&gt;&lt;p&gt;&lt;b&gt;Ready for outreach ({!Outreach_Ready_Count}):&lt;/b&gt;&lt;br/&gt;{!Outreach_Ready_List}&lt;/p&gt;&lt;p&gt;&lt;b&gt;Needs enrichment ({!Needs_Enrichment_Count}):&lt;/b&gt;&lt;br/&gt;{!Needs_Enrichment_List}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Contact_Screen</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <transforms>
        <name>Transform_contacts</name>
        <label>Transform contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <apexClass>ContactWrapperDemo</apexClass>
        <connector>
            <targetReference>Loop_Contacts</targetReference>
        </connector>
        <dataType>Apex</dataType>
        <isCollection>true</isCollection>
        <scale>0</scale>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <transformValues>
            <transformValueActions>
                <outputFieldApiName>contactEmail</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <elementReference>contactsToProcess[$EachItem].Email</elementReference>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>contactFirstName</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <elementReference>contactsToProcess[$EachItem].FirstName</elementReference>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>contactId</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <elementReference>contactsToProcess[$EachItem].Id</elementReference>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>contactLastName</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <elementReference>contactsToProcess[$EachItem].LastName</elementReference>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>contactPhone</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <elementReference>contactsToProcess[$EachItem].MobilePhone</elementReference>
                </value>
            </transformValueActions>
        </transformValues>
    </transforms>
    <variables>
        <name>contactsToProcess</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <name>currentItem_Filter_Incomplete_Contacts</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <name>Needs_Enrichment_Count</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>Needs_Enrichment_List</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>newTask</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Task</objectType>
    </variables>
    <variables>
        <name>Outreach_Ready_Count</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>Outreach_Ready_List</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>tasksToCreate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Task</objectType>
    </variables>
</Flow>
